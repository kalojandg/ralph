{
  "prompt_file": "PROMPT.md",
  "claude_args": [
    "--output-format", "text",
    "--model", "claude-opus-4-8",
    "--dangerously-skip-permissions"
  ],
  "prerequisite_steps": {
    "enabled": true,
    "steps_file": "prerequisite-steps.md"
  },
  "user_defined_steps": {
    "enabled": true,
    "steps_file": "user-steps.md",
    "append_to_prompt": true
  },
  "task_steps": {
    "enabled": true,
    "steps_file": "task-steps.json"
  },
  "feedback": {
    "enabled": true,
    "feedback_file": "feedback.md",
    "append_after_iteration": true
  },
  "logging": {
    "enabled": true,
    "log_dir": "logs",
    "save_iterations": true
  },
  "tdd": {
    "enabled": true,
    "test_commands": {
      "unit": "npm run test:run",
      "e2e": "npm run e2e",
      "lint": "npm run lint",
      "typecheck": "npm run type-check"
    },
    "visual_testing": {
      "mcp_server": "cursor-ide-browser",
      "dev_server": "npm run dev",
      "designs_folder": "docs/composition/designs"
    },
    "mock_backend": {
      "type": "localStorage",
      "storage_key": "bdz_mockups"
    }
  }
}
